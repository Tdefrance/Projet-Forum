/* =========================================================
   1.4 - AUTHENTIFICATION
   ========================================================= */

/* Utilisateur de test */
$email_test = "test@test.fr";
$mdp_test = "1234";
$pseudo_test = "Thomas";

/* Nombre d'erreurs */
if (!isset($_SESSION['erreurs'])) {
    $_SESSION['erreurs'] = 0;
}

/* Connexion */
if (isset($_POST['connexion'])) {

    $log = $_POST['log'];
    $pass = $_POST['pass'];

    if ($log == $email_test && $pass == $mdp_test) {

        $_SESSION['connecte'] = true;
        $_SESSION['pseudo'] = $pseudo_test;
        $_SESSION['erreurs'] = 0;

        header("Location: ?");
        exit;

    } else {

        $_SESSION['erreurs']++;

        if ($_SESSION['erreurs'] >= 3) {
            sleep(5);
            $_SESSION['erreurs'] = 0;
        }
    }
}


/* Déconnexion */
if (isset($_GET['deconnexion'])) {

    session_destroy();

    header("Location: ?");
    exit;
}


/* Vérification de la connexion */
$est_authentifie = $_SESSION['connecte'] ?? false;


/* =========================================================
   NAVIGATION
   ========================================================= */

$action = isset($_GET['action']) ? $_GET['action'] : null;

$id_theme_clique = isset($_GET['id'])
    ? intval($_GET['id'])
    : null;


/* =========================================================
   1.3 - INSCRIPTION
   ========================================================= */

$message_erreur = "";
$message_succes = "";

if (
    $_SERVER['REQUEST_METHOD'] === 'POST'
    && isset($_POST['inscription_soumise'])
) {

    $email = trim($_POST['email'] ?? '');
    $pass1 = $_POST['password'] ?? '';
    $pass2 = $_POST['password_confirm'] ?? '';
    $pseudo = trim($_POST['pseudo'] ?? '');
    $captcha = trim($_POST['captcha'] ?? '');

    if (
        empty($email)
        || empty($pass1)
        || empty($pass2)
        || empty($pseudo)
        || empty($captcha)
    ) {

        $message_erreur =
            "Veuillez remplir tous les champs obligatoires.";

    } elseif ($pass1 !== $pass2) {

        $message_erreur =
            "Les mots de passe ne correspondent pas.";

    } elseif ($captcha !== "42") {

        $message_erreur =
            "Le code de vérification est incorrect.";

    } else {

        $message_succes =
            "Inscription réussie ! Un e-mail de confirmation a été envoyé à "
            . htmlspecialchars($email)
            . " (valable 24h).";
    }
}


/* =========================================================
   RETROUVER LE TITRE DU THEME
   ========================================================= */

$titre_theme_clique = "";

