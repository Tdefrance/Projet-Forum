$message_succes = "";

// Traitement du formulaire d'inscription (Question 1.3)
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['inscription_soumise'])) {
    $email = trim($_POST['email'] ?? '');
    $pass1 = $_POST['password'] ?? '';
    $pass2 = $_POST['password_confirm'] ?? '';
    $pseudo = trim($_POST['pseudo'] ?? '');
    $captcha = trim($_POST['captcha'] ?? '');

    if (empty($email) || empty($pass1) || empty($pass2) || empty($pseudo) || empty($captcha)) {
        $message_erreur = "Veuillez remplir tous les champs obligatoires.";
    } elseif ($pass1 !== $pass2) {
        $message_erreur = "Les mots de passe ne correspondent pas (double vérification échouée).";
    } elseif ($captcha !== "42") { // Simulation simple de captcha (ex: 40 + 2 = 42)
        $message_erreur = "Le code de vérification (Captcha) est incorrect.";
    } else {
        // Succès de l'inscription : simulation de l'envoi du mail avec URL valable 1 jour
        $message_succes = "Inscription réussie ! Un e-mail de confirmation a été envoyé à <strong>" . htmlspecialchars($email) . "</strong> (valable 24h).";
    }
}

